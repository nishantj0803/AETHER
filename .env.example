# ==============================================================================
# Aether Environment Configuration
# ==============================================================================

# Core Service Configuration
SERVICE_NAME=payment-service
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Streaming Broker (Kafka / Redpanda)
# Local Docker host: localhost:19092, Container network: redpanda:9092
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_CONSUMER_GROUP=aether-ingestion-workers
KAFKA_TOPIC_LOGS=telemetry.logs
KAFKA_TOPIC_DLQ=telemetry.dlq

# Storage & Semantic Search (PostgreSQL 16 + pgvector)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://aether_user:aether_password@localhost:5432/aether_db
PGVECTOR_COLLECTION=telemetry_logs

# Observability (Prometheus & Grafana)
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3000
DEMO_SERVICE_URL=http://localhost:8000

# Zero-Trust Policy Engine Guardrails
POLICY_RATE_LIMIT_SECONDS=300
POLICY_MIN_REPLICAS=1
POLICY_MAX_REPLICAS=10
POLICY_AUTONOMOUS_CONFIDENCE_THRESHOLD=0.80

# Autonomous SRE RCA Agent (Google Gemini)
# Obtain key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODEL=gemini-3.8-flash

# Enterprise ChatOps & Alerting (Slack / Discord / PagerDuty)
AETHER_BASE_URL=http://localhost:8000
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
PAGERDUTY_ROUTING_KEY=
PAGERDUTY_EVENTS_URL=https://events.pagerduty.com/v2/enqueue
GENERIC_WEBHOOK_URL=

